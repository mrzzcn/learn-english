// Cloudflare Workers 静态资源部署配置。
// 构建命令 pnpm build 生成 dist/，部署命令 npx wrangler deploy 上传 dist/。
// 有了这个文件，wrangler 就不会进入自动配置、往项目里安装 wrangler 依赖。
{
  "name": "learn-english",
  "compatibility_date": "2026-09-25",
  // Workers 可观测性：在 Cloudflare 控制台查看日志和请求指标
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // 找不到页面时返回 dist/404.html
    "not_found_handling": "404-page"
  }
}
